{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "MRI preprocessing pipeline",
      "type": "debugpy",
      "request": "launch",
      "module": "python_scripts.mri_preprocessing.pipeline",
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
