      "module": "python_scripts.mesh_analysis.pipeline",
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      },
      "cwd": "${workspaceFolder}",
      "args": ["--subject", "IXI012-HH-1211-T1"],
      "justMyCode": true,
      "logToFile": false
    }
  ]
}